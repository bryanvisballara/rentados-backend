NODE_ENV=development
PORT=3000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/rentados?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:5174

# Cloudinary (publicaciones y casillero — imágenes optimizadas)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternativa: CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Gmail → facturas Air-e (OAuth readonly)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/gmail/callback
APP_WEB_URL=http://localhost:5578
# Push casi en tiempo real (Google Cloud Pub/Sub + users.watch)
# Ejemplo: projects/MI_PROYECTO/topics/gmail-rentados
GMAIL_PUBSUB_TOPIC=
# Centro Inteligente de Facturas (opcional pero recomendado)
OPENAI_API_KEY=
# OPENAI_INVOICE_MODEL=gpt-4o-mini
# Opcional: secreto aparte para cifrar refresh tokens (por defecto usa JWT_SECRET)
# GMAIL_TOKEN_SECRET=

# Render / producción
RUN_DB_SYNC=false
DEPLOY_KEY=genera-un-secreto-largo-para-sync-remoto
RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-XXXXXXXX?key=XXXXXXXX
